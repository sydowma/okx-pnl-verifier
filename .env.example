# OKX API Credentials (Read-Only permission is sufficient!)
OKX_API_KEY=your_api_key_here
OKX_API_SECRET=your_api_secret_here
OKX_PASSPHRASE=your_passphrase_here

# Set to 1 if using OKX Demo Trading (paper trading), 0 for live account
OKX_SIMULATED=0

# Optional: override REST / WS endpoints if needed
# OKX_BASE_URL=https://www.okx.com
# OKX_WS_URL=wss://ws.okx.com:8443/ws/v5/private
